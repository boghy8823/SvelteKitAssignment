{
	"name": "take-home-senior-frontend-sveltekit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": "^24.19.0",
		"pnpm": "^11.22.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:node": "cross-env BUILD_ADAPTER=node vite build",
		"preview": "vite preview",
		"preview:node": "node build",
		"prepare": "svelte-kit sync && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
		"i18n:types": "node tools/generate-i18n-types.ts",
		"i18n:check": "node tools/generate-i18n-types.ts --check",
		"lint": "pnpm i18n:check && prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run --project unit",
		"test:component": "vitest run --project component",
		"test:watch": "vitest",
		"test": "vitest run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource/inter": "^5.3.0",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"cross-env": "^10.1.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"satori": "^0.29.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"zod": "^4.4.3"
	}
}
